{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,

    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["./src", "test/miniMaple.test.ts"]
}
